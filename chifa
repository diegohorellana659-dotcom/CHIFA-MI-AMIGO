function renderProductos(){document.getElementById('productos').innerHTML=platos.filter(p=>filtroActual==='Todos'||p.categoria===filtroActual).map(p=>`<article class="producto"><span class="tipo">${p.categoria}</span><h3>${p.nombre}</h3><p>${p.descripcion}</p><strong class="precio">${moneda(p.precio)}</strong><button data-agregar="${p.id}">+ Agregar al pedido</button></article>`).join('');document.querySelectorAll('[data-agregar]').forEach(b=>b.addEventListener('click',()=>{cambiarCantidad(Number(b.dataset.agregar),1);document.getElementById('pedido').scrollIntoView({behavior:'smooth'})}))}
function cambiarCantidad(id,cambio){carrito[id]=Math.max(0,(carrito[id]||0)+cambio);renderPedido()}
function renderPedido(){document.getElementById('pedido-lista').innerHTML=platos.map(p=>`<div class="pedido-fila"><div><strong>${p.nombre}</strong><small>${moneda(p.precio)} por unidad</small></div><div class="cantidad"><button aria-label="Quitar uno de ${p.nombre}" data-restar="${p.id}">−</button><output>${carrito[p.id]||0}</output><button aria-label="Agregar uno de ${p.nombre}" data-sumar="${p.id}">+</button></div><strong class="subtotal">${moneda(p.precio*(carrito[p.id]||0))}</strong></div>`).join('');document.querySelectorAll('[data-sumar]').forEach(b=>b.addEventListener('click',()=>cambiarCantidad(Number(b.dataset.sumar),1)));document.querySelectorAll('[data-restar]').forEach(b=>b.addEventListener('click',()=>cambiarCantidad(Number(b.dataset.restar),-1)));const elegidos=platos.filter(p=>(carrito[p.id]||0)>0);const total=elegidos.reduce((s,p)=>s+p.precio*carrito[p.id],0);const lineas=elegidos.map(p=>`${carrito[p.id]} × ${p.nombre} — ${moneda(p.precio*carrito[p.id])}`);document.getElementById('detalle').textContent=lineas.length?lineas.join('\n'):'Aún no has agregado platos.';document.getElementById('total').textContent=moneda(total);const mensaje=elegidos.length?`Hola, quisiera consultar la disponibilidad y el precio actualizado de este pedido:\n\n${lineas.join('\n')}\n\nTotal referencial: ${moneda(total)}\n\n¿Me confirman el monto final y las opciones de entrega?`:'Hola, quisiera consultar la carta, los precios y la disponibilidad.';document.getElementById('whatsapp-pedido').href='https://wa.me/51912111093?text='+encodeURIComponent(mensaje)}
const sugerencias={arroz:1,tallarines:5,pollo:9,compartir:15};document.querySelectorAll('[data-gusto]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-gusto]').forEach(x=>x.classList.remove('elegida'));b.classList.add('elegida');const p=platos.find(x=>x.id===sugerencias[b.dataset.gusto]);document.getElementById('resultado').innerHTML=`<strong>Te recomendamos: ${p.nombre}</strong><p>${p.descripcion} Precio referencial: ${moneda(p.precio)}.</p><button class="boton" id="agregar-recomendado">Agregar a mi pedido</button>`;document.getElementById('agregar-recomendado').addEventListener('click',()=>{cambiarCantidad(p.id,1);document.getElementById('pedido').scrollIntoView({behavior:'smooth'})})}));
const botonMenu=document.getElementById('abrir-menu'),nav=document.getElementById('navegacion');botonMenu.addEventListener('click',()=>{const abierta=nav.classList.toggle('abierta');botonMenu.setAttribute('aria-expanded',String(abierta))});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('abierta');botonMenu.setAttribute('aria-expanded','false')}));document.getElementById('anio-actual').textContent=new Date().getFullYear();renderFiltros();renderProductos();renderPedido();
</script>
</body>
